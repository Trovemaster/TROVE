         3   1  cos    2  0.5
         4   1  sin    1  1.0
end

BASIS
  0,'JKtau', Jrot 0, kmax 2
  1,'numerov','auto', 'pot-auto',  range 0, 4, resc 3.0, points 1000, borders 0.90,1.70
  2,'numerov','auto', 'pot-auto',  range 0, 4, resc 5.0, points 1000, borders 0.70,1.80
  2,'numerov','auto', 'pot-auto',  range 0, 4, resc 5.0, points 1000, borders 0.70,1.80
