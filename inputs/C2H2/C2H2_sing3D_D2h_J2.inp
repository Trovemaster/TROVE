PTorder   0   (Max Perturbation order)
KinOrder  10  (Max order in the kinetic energy expansion)
PotOrder  10  (Max order in the potential energy expansion)

Natoms 4      (Number of atoms)
Nmodes 6      (Number of modes = 3*Natoms-6)

(C2H2 6D test of J=1 rovibrational states with K-parametrised singular_3D and D2h(M))

PRIMITIVES
  Npolyads      12      (how many polyads we calculate)
  enercut    40000.0   (energy cut in the primitive matrix for the diagonalization)
END

CONTRACTION
  Npolyads        12
  enercut       40000.0
  coeff_thresh  1.0e-14
  degeneracy    1e-2
  sample_points  40
  sample_attempts 500
  symm_toler      1e-3
END

SYMGROUP   D2h(M)

DIAGONALIZER
  SYEV
  enermax 10000
end

verbose 4

dstep 0.005    (finite difference element for each mode )

COORDS     local
frame      BC-Z-CD-X
TRANSFORM  r1-r2-r3-rho1-rho2-tau-abs
MOLTYPE    abcd
REFER-CONF non-RIGID  (Reference configuarion: RIGID or NON-RIGID)
MOLECULE   C2H2

ZMAT
    C   0  0  0  0  12.00000000
    C   1  0  0  0  12.00000000
    H   1  2  0  0   1.00782505
    H   2  1  3  2   1.00782505
end

CHECK_POINT
ascii
potential   read with_modes
kinetic     read with_modes
external    none
basis_set   read
CONTRACT    read
matelem     read  split
extmatelem  none  split
EIGENFUNC   save
END

sparse

BASIC-FUNCTION POTEN
Mode 1 5
1, 0 - 4, morse(x-xe)
Mode 2 5
1, 0 - 4, morse(x-xe)
Mode 3 5
1, 0 - 4, morse(x-xe)
Mode 4 35
1, 0 - 4, x-xe
2, 0 - 4, x-xe, 1 sin 1.0 1
2, 0 - 4, x-xe, 2 sin 1.0 1
2, 0 - 4, x-xe, 3 sin 1.0 1
2, 0 - 4, x-xe, 4 sin 1.0 1
2, 0 - 4, x-xe, 5 sin 1.0 1
2, 0 - 4, x-xe, 6 sin 1.0 1
Mode 5 35
1, 0 - 4, x-xe
2, 0 - 4, x-xe, 1 sin 1.0 1
2, 0 - 4, x-xe, 2 sin 1.0 1
2, 0 - 4, x-xe, 3 sin 1.0 1
2, 0 - 4, x-xe, 4 sin 1.0 1
2, 0 - 4, x-xe, 5 sin 1.0 1
2, 0 - 4, x-xe, 6 sin 1.0 1
Mode 6 7
1, 0 - 6, cosnx
end

BASIC-FUNCTION  mass
Mode     1   2
         1   1   R    -1    1
         2   1   R    -2    1
Mode     2   2
         1   1   R    -1    1
         2   1   R    -2    1
Mode     3   2
         1   1   R    -1    1
         2   1   R    -2    1
Mode     4   9
       1   1  sin    1  1
       2   1  cos    1  1
       3   1  csc_   1  1
       4   1  csc_   2  1
       5   1  cot_   1  1
       6   1  cot_   2  1
       7   2  cos    1  1   csc_   2  1
       8   1  sin    1  2
       9   1  cos    2  1
Mode     5   9
       1   1  sin    1  1
       2   1  cos    1  1
       3   1  csc_   1  1
       4   1  csc_   2  1
       5   1  cot_   1  1
       6   1  cot_   2  1
       7   2  cos    1  1   csc_   2  1
       8   1  sin    1  2
       9   1  cos    2  1
Mode     6   4
         1   1  sin    1  0.5
         2   1  cos    1  0.5
         3   1  cos    2  0.5
         4   1  sin    1  1.0
end

BASIS
  0,'JKtau', Jrot 2, kmax 2
  1,'numerov','auto', 'pot-auto',  range 0, 4, resc 3.0, points 1000, borders 0.90,1.70
  2,'numerov','auto', 'pot-auto',  range 0, 4, resc 5.0, points 1000, borders 0.70,1.80
  2,'numerov','auto', 'pot-auto',  range 0, 4, resc 5.0, points 1000, borders 0.70,1.80
  3,'sinrho-legendre-k-sing','auto-singular','pot-auto', range 0,24, resc 2.0, points 1000, borders 0.,150. deg, lmax 4
  3,'sinrho-legendre-k-sing','auto-singular','pot-auto', range 0,24, resc 2.0, points 1000, borders 0.,150. deg, lmax 4
  3,'fourier-unoptimised','auto', 'pot-auto', range 0, 16, resc 0.5, points 1000, borders 0., 720.0 deg, periodic 1
END

EQUILIBRIUM
