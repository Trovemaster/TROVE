r_CH1       0     1.06268311
r_CH2       0     1.06268311
alpha1      0   180.00000000  deg
alpha2      0   180.00000000  deg
tau         0     0.00000000  deg
end

SPECPARAM
a_CC        0     1.95000000
a_CH1       0     1.92000000
a_CH2       0     1.92000000
