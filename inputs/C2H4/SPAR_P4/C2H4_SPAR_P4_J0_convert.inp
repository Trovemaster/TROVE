mem 400 gb

KinOrder  6
PotOrder  8

Natoms 6
Nmodes 12


PRIMITIVES
  Npolyads   4
  enercut    40000.0
END


CONTRACTION
  Npolyads        4
  enercut         18000.0
  coeff_thresh    1.0d-30
  degeneracy      1d-02
  sample_points   40
  sample_attempts 500
  symm_toler      1.0d-3
  exp_coeff_thresh 1.0d-2
  cluster 2.0
  model j=0
END


SYMGROUP D2H(M)


DIAGONALIZER
 SYEVR
 enermax 16000.0
end


verbose 4


dstep            1.0e-02
COORDS           local
TRANSFORM        C2H4_SPAR
MOLTYPE          C2H4
MOLECULE         C2H4
REFER-CONF       RIGID

ZMAT
  C   0  0  0  0  12.00000000
  C   1  0  0  0  12.00000000
  H   1  2  0  0   1.00782505
  H   1  2  3 -2   1.00782505
  H   2  1  3  2   1.00782505
  H   2  1  5 -2   1.00782505
end


BASIS
 0,'JKtau', Jrot 0
 1,'numerov','automatic', 'pot-auto',  range 0,14, r,8   resc 1.0, points 4000, borders -0.5,0.6
 2,'numerov','automatic', 'pot-auto',  range 0,7,  r,8, resc 2.0, points 4000, borders -0.5,0.6
