    C   0  0  0  0  12.00000000
    S   1  0  0  0  31.97207100
    H   1  2  0  0   1.00782505
    H   1  2  3 -2   1.00782505
end

CHECK_POINT
ascii
potential   save
kinetic     read
external    save
basis_set   none
CONTRACT    save
matelem     none  split
extmatelem  none  split
EIGENFUNC   save
END






